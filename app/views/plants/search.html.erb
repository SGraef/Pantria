<% content_for :title, t("plant.search_title") %>
<h1><%= t("plant.search_title") %></h1>
<p><%= link_to t("common.back"), plants_path, class: "btn btn-secondary" %></p>

<div class="card">
  <%= form_with url: search_plants_path, method: :get, local: true do %>
    <p>
      <%= text_field_tag :q, @query, placeholder: t("plant.search_placeholder") %>
      <%= submit_tag t("plant.search_button"), class: "btn" %>
    </p>
  <% end %>
</div>

<% if @results.any? %>
  <table>
    <thead>
      <tr>
        <th></th>
        <th><%= t("plant.table.name") %></th>
        <th><%= t("plant.field.cycle") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @results.each do |r| %>
        <tr>
          <td>
            <% if r.image_url.present? %>
              <%= image_tag r.image_url, alt: r.common_name, loading: "lazy",
                            style: "width:44px;height:44px;object-fit:cover;border-radius:var(--radius-sm)" %>
            <% end %>
          </td>
          <td>
            <strong><%= r.common_name %></strong>
            <% if r.scientific_name.present? %><br><span class="caption"><em><%= r.scientific_name %></em></span><% end %>
          </td>
          <td><%= r.cycle.presence && t("plant.cycles.#{r.cycle}", default: r.cycle) %></td>
          <td>
            <%= form_with url: import_plants_path, method: :post, local: true do %>
              <%= hidden_field_tag :perenual_id, r.perenual_id %>
              <%= hidden_field_tag :common_name, r.common_name %>
              <%= hidden_field_tag :scientific_name, r.scientific_name %>
              <%= hidden_field_tag :cycle, r.cycle %>
              <%= hidden_field_tag :image_url, r.image_url %>
              <%= submit_tag t("plant.import_button"), class: "btn btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif @query.present? && flash[:alert].blank? %>
  <p><%= t("plant.no_results", query: @query) %></p>
<% end %>
